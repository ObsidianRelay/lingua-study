{
  "name": "obsidian-lingua-study",
  "version": "1.0.1",
  "description": "Study languages in Obsidian with timestamped YouTube transcripts and on-demand AI translation.",
  "private": true,
  "license": "MIT",
  "author": "xiaobai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ObsidianRelay/lingua-study.git"
  },
  "bugs": {
    "url": "https://github.com/ObsidianRelay/lingua-study/issues"
  },
  "homepage": "https://github.com/ObsidianRelay/lingua-study#readme",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "test": "node esbuild.test.mjs && node --test .test-dist/translation-core.test.cjs",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "lint": "eslint src",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "check:release": "node scripts/check-release.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "globals": "^17.10.0",
    "jiti": "^2.7.0",
    "obsidian": "^1.13.1",
    "tslib": "^2.8.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.67.0"
  }
}
